# Target: M5Dial v1.0 (M5Stamp-S3, ESP32-S3FN8: 8 MB flash, no PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Console on the native USB (G19/G20, USB-Serial-JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000

# Task watchdog (SPEC 5, Watchdog): 3 s, panic and reset
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# LVGL 9.5.0
CONFIG_LV_FONT_MONTSERRAT_28=y

# Custom partition table: 3 MB app
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
